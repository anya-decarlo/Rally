{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rally-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rally-db",
      "database_id": "b136a854-7cbf-4381-981e-1e55ee824e49",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["15 * * * *", "30 10 * * *"]
  }
}
